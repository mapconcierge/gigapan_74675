<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2" xmlns:kml="http://www.opengis.net/kml/2.2" xmlns:atom="http://www.w3.org/2005/Atom">
  
    <Document>

      <name>Panoramas</name>
      <open>1</open>

      <Style id="panoramaStyle">
        <IconStyle>
          <Icon><href>http://gigapan.org/images/ge_icon.png</href></Icon>
        </IconStyle>
        <BalloonStyle>
          <text>$[description]</text>
        </BalloonStyle>
      </Style>

      
  <PhotoOverlay id="gigapan_74675">
  <name>Japanese Cherry Blossom Party 2</name>
  <Snippet maxLines="1">
    <![CDATA[<a href="#gigapan_74675">Enter panorama</a>]]>
  </Snippet>

  
    <description>
      <![CDATA[

        <div align="center">

          <table width="500">
            <tr>
              <td>
                <a href="http://gigapan.org">
                  <img alt="Logo" src='http://gigapan.org/images/logo.png?1380819533/' />
                </a>
              </td>
              <td>
                <font size="10">$[name]</font>
                <hr>
                <a href="#gigapan_74675;flyto">Enter Panorama</a> |
                <a href="http://gigapan.org/gigapans/74675">
                  "Panorama at GigaPan.com"</a>
              </td>
            </tr>
            <tr>
              <td colspan="2" align="center">
                <a href="#gigapan_74675"><img alt="Japanese Cherry Blossom Party 2" class="thumbnail" src="//static.gigapan.com/gigapans0/74675/images/74675-500x188.jpg" title="Japanese Cherry Blossom Party 2" /></a>
              </td>
            </tr>
            <tr>
              <td colspan="2">
                <p></p>
                <p>Explore Score: $[score]</p>
                <p align="right">
                  <b>Author</b>:
                  <a href="http://gigapan.org/profiles/mapconcierge">
                    Taichi FURUHASHI
                  </a>
                </p>
              </td>
            </tr>
          </table>
        </div>
      ]]>
    </description>
  

  <Camera id="gigapan_74675_camera">
    <longitude>139.434496</longitude>
    <latitude>35.798088</latitude>
    <altitude>6.0</altitude>
    <heading>0.0</heading>
    <tilt>90.0</tilt>
    <roll>0.0</roll>
  </Camera>

  <styleUrl>#panoramaStyle</styleUrl>

  <ExtendedData>
    <Data name="score">
      <value>1.0</value>
    </Data>
  </ExtendedData>

  <color>feffffff</color>

  <Icon>
    <href>ge_tiles/$[level]/$[y]/$[x].jpg</href>
  </Icon>

  <rotation>0.0</rotation>

  <ViewVolume id="gigapan_74675_viewvolume">
    <leftFov>-180.0</leftFov>
    <rightFov>180.0</rightFov>
    <bottomFov>-59.7618</bottomFov>
    <topFov>75.7055182651191</topFov>
    <near>15.0</near>
  </ViewVolume>

  <ImagePyramid>
    <tileSize>256</tileSize>
    <maxWidth>39288</maxWidth>
    <maxHeight>14784</maxHeight>
    <gridOrigin>upperLeft</gridOrigin>
  </ImagePyramid>

  <Point id="gigapan_74675_point">
    <coordinates>139.434496,35.798088</coordinates>
  </Point>

  <shape>sphere</shape>

</PhotoOverlay>




    </Document>
  
</kml>
